# Kopieren nach backend/.env und anpassen.

SUBSUMO_ENVIRONMENT=dev
SUBSUMO_DATABASE_URL=sqlite:///./subsumo.db

# In Produktion zwingend setzen: openssl rand -hex 32
SUBSUMO_JWT_SECRET=dev-only-insecure-change-me

# KI-Korrektur. Ohne Key laeuft der heuristische Fallback.
SUBSUMO_LLM_PROVIDER=none
SUBSUMO_LLM_MODEL=claude-sonnet-5
SUBSUMO_LLM_API_KEY=

SUBSUMO_DEFAULT_DAILY_MINUTES=90
